# AEGIS local MVP environment (single-tenant, single-region, synthetic data).
# Copy to .env for local overrides. Compose provides safe defaults so this is optional.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
# Superuser used ONLY for migrations/bootstrap.
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis_admin_pw
# Least-privilege runtime roles (created by migrations).
GATEWAY_DB_USER=aegis_gateway
GATEWAY_DB_PASSWORD=aegis_gateway_pw
CONTROL_DB_USER=aegis_control
CONTROL_DB_PASSWORD=aegis_control_pw
AUDIT_READER_DB_USER=aegis_audit_reader
AUDIT_READER_DB_PASSWORD=aegis_audit_reader_pw

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Tenancy (MVP is single-tenant) ---
AEGIS_TENANT_ID=tenant_demo

# --- Gateway ---
GATEWAY_PORT=8080
# HMAC secret used to verify development agent workload credentials (JWT-like).
# In production this is replaced by OIDC/SPIFFE; see docs/ADR notes.
AGENT_JWT_HMAC_SECRET=dev-agent-signing-secret-change-me
# Freshness deadline (seconds) for cached halt/revocation state before fail-closed.
SAFETY_FRESHNESS_SECONDS=5
# Gateway-only credential presented to the mock bank.
BACKEND_GATEWAY_CREDENTIAL=gw-only-shared-secret

# --- Control plane ---
CONTROL_PORT=8000
# HMAC secret used to verify operator JWTs (dev OIDC stand-in).
OPERATOR_JWT_HMAC_SECRET=dev-operator-signing-secret-change-me
# MVP single-admin mode: labelled and audited. When true, dual-control is bypassed.
AEGIS_SINGLE_ADMIN_MODE=true

# --- Mock bank ---
MOCKBANK_PORT=9090

# --- Dashboard ---
DASHBOARD_PORT=5173
